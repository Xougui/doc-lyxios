---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import error500 from '../assets/error/500_svg.svg';

interface Props {
  error: unknown;
}

const { error } = Astro.props;

// Log the error for debugging purposes (this will appear in server logs)
if (error) {
  console.error("500 Error encountered:", error);
}
---

<StarlightPage frontmatter={{
  title: '500 - Erreur interne',
  template: 'splash',
  editUrl: false,
  hero: {
    title: '',
    image: { file: error500, alt: '500' },
    actions: [
      {
        text: "Retour à l'accueil",
        link: '/',
        icon: 'right-arrow',
        variant: 'primary'
      },
      {
        text: "Signaler sur Discord",
        link: 'https://discord.gg/RZHrtzwUC2',
        icon: 'discord',
        variant: 'secondary'
      }
    ]
  }
}}>
</StarlightPage>
