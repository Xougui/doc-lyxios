---
interface Command {
  name: string;
  description: string;
  params: string[];
  categorie: string;
  id: string | number;
}

let commands: Command[] = [];

try {
  const response = await fetch('https://api-lyxios.xouxou-hosting.fr/api/v1/commands');
  if (response.ok) {
    const data = await response.json();
    commands = (data.commands || []) as Command[];
  }
} catch (error) {
  console.error("Erreur lors du chargement des commandes depuis l'API:", error);
}

// Group commands by category
const groupedCommands: Record<string, Command[]> = {};

commands.forEach((cmd) => {
  const category = cmd.categorie || 'Autres';
  if (!groupedCommands[category]) {
    groupedCommands[category] = [];
  }

  // Clean the command name
  // Input example: "<:command_slash:1347249705381269658>・**</liste-serveurs:1353345811441778709>**"
  // Output desired: "/liste-serveurs"
  const match = cmd.name.match(/<\/([^:]+):/);
  const cleanName = match ? `/${match[1]}` : cmd.name;

  // Clone and update the name
  const cleanCmd = { ...cmd, name: cleanName };
  groupedCommands[category].push(cleanCmd);
});

// Sort categories alphabetically
const sortedCategories = Object.keys(groupedCommands).sort();

// Fonction pour créer un slug (ID) valide à partir du nom de la catégorie
const slugify = (text: string) => {
  return text
    .toString()
    .toLowerCase()
    .normalize('NFD') // Décompose les accents
    .replace(/[\u0300-\u036f]/g, '') // Supprime les accents
    .replace(/[^a-z0-9]+/g, '-') // Remplace les caractères non-alphanumériques par des tirets
    .replace(/(^-|-$)+/g, ''); // Supprime les tirets en début/fin
};
---

<div class="command-list-container">
  <div class="search-wrapper">
    <input type="text" id="command-search" placeholder="Rechercher une commande..." aria-label="Rechercher une commande" />
  </div>

  {sortedCategories.map((category) => (
    <div class="category-section">
      <h2 id={slugify(category)} class="category-title">{category}</h2>
      <table>
        <thead>
          <tr>
            <th style="width: 40%">Commande</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody class="command-group">
          {groupedCommands[category].map((cmd) => (
            <tr class="command-row">
              <td>
                <div class="cmd-name-wrapper">
                  <code>{cmd.name}</code>
                  {cmd.params && cmd.params.length > 0 && (
                    <span class="cmd-params">
                      {cmd.params.map(p => <span class="param-tag">{p}</span>)}
                    </span>
                  )}
                </div>
              </td>
              <td>{cmd.description}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ))}

  {sortedCategories.length === 0 && (
    <p class="empty-message">Aucune commande trouvée pour le moment.</p>
  )}
  <p id="no-results" class="empty-message hidden">Aucun résultat pour cette recherche.</p>
</div>

<style>
  .search-wrapper {
    margin-bottom: 2rem;
  }
  
  #command-search {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background-color: var(--sl-color-black);
    color: var(--sl-color-white);
    font-size: 1rem;
  }

  #command-search:focus {
    border-color: var(--sl-color-accent);
    outline: none;
  }

  .category-section {
    margin-bottom: 2rem;
  }

  .cmd-name-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: flex-start;
  }

  .cmd-params {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    font-size: 0.8em;
  }

  .param-tag {
    background-color: var(--sl-color-gray-6);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    color: var(--sl-color-gray-2);
  }

  .hidden {
    display: none !important;
  }

  /* Basic table styling to match Starlight if not inherited automatically */
  table {
    width: 100%;
    margin-bottom: 1rem;
    display: table; /* Ensure table display */
  }
</style>

<script>
  const searchInput = document.getElementById('command-search') as HTMLInputElement;
  const noResultsMsg = document.getElementById('no-results');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const term = (e.target as HTMLInputElement).value.toLowerCase();
      const sections = document.querySelectorAll('.category-section');
      let hasVisibleCommands = false;

      sections.forEach((section) => {
        const rows = section.querySelectorAll('.command-row');
        let hasVisibleRowsInSection = false;

        rows.forEach((row) => {
          const text = (row.textContent || '').toLowerCase();
          const isVisible = text.includes(term);
          (row as HTMLElement).style.display = isVisible ? '' : 'none';
          if (isVisible) hasVisibleRowsInSection = true;
        });

        (section as HTMLElement).style.display = hasVisibleRowsInSection ? '' : 'none';
        if (hasVisibleRowsInSection) hasVisibleCommands = true;
      });

      if (noResultsMsg) {
        noResultsMsg.classList.toggle('hidden', hasVisibleCommands);
      }
    });
  }

  // Script pour injecter dynamiquement les catégories dans la Table des Matières (ToC) de Starlight
  // Nécessaire car Starlight ne détecte pas les titres générés dynamiquement dans les composants Astro
  window.addEventListener('DOMContentLoaded', () => {
    // Sélecteur pour la ToC de Starlight (peut varier légèrement selon la version, mais c'est le standard)
    const tocContainer = document.querySelector('starlight-toc nav > ul') || document.querySelector('.right-sidebar nav > ul');
    
    if (tocContainer) {
      const categories = document.querySelectorAll('.category-section h2');
      
      categories.forEach((heading) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        
        a.href = `#${heading.id}`;
        a.textContent = heading.textContent;
        
        li.appendChild(a);
        tocContainer.appendChild(li);
      });
    }
  });
</script>
