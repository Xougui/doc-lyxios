---
interface Command {
  name: string;
  description: string;
  params: string[];
  categorie: string;
  id: string;
}

interface CommandData {
  commands: Command[];
}

interface ApiResponse {
  status: string;
  data: CommandData;
}

let commands: Command[] = [];
try {
  const response = await fetch('https://api-lyxios.xouxou-hosting.fr/api/v1/commands');
  if (response.ok) {
    const json = (await response.json()) as ApiResponse;
    commands = json.data.commands;
  } else {
    console.error(`Erreur API: ${response.status} ${response.statusText}`);
  }
} catch (error) {
  console.error("Erreur de connexion lors de la récupération des commandes:", error);
}

// Group commands by category
const groupedCommands: Record<string, Command[]> = {};

commands.forEach((cmd) => {
  const category = cmd.categorie || 'Autres';
  if (!groupedCommands[category]) {
    groupedCommands[category] = [];
  }

  // Clean the command name
  // Input example: "<:command_slash:1347249705381269658>・**</liste-serveurs:1353345811441778709>**"
  // Output desired: "/liste-serveurs"
  const match = cmd.name.match(/<\/([^:]+):/);
  const cleanName = match ? `/${match[1]}` : cmd.name;

  // Clone and update the name
  const cleanCmd = { ...cmd, name: cleanName };
  groupedCommands[category].push(cleanCmd);
});

// Sort categories alphabetically
const sortedCategories = Object.keys(groupedCommands).sort();
---

<div class="command-list">
  {sortedCategories.map((category) => (
    <div class="category-section">
      <h2>{category}</h2>
      <table>
        <thead>
          <tr>
            <th>Commande</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {groupedCommands[category].map((cmd) => (
            <tr>
              <td><code>{cmd.name}</code></td>
              <td>{cmd.description}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ))}
</div>

<style>
  .category-section {
    margin-bottom: 2rem;
  }
  /* Basic table styling to match Starlight if not inherited automatically */
  table {
    width: 100%;
    margin-bottom: 1rem;
    display: table; /* Ensure table display */
  }
</style>
